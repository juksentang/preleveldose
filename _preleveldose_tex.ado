*! _preleveldose_tex 0.6 09oct2026 -- internal table writer
program define _preleveldose_tex
    version 15.1
    syntax using/ , R2(real) B(real) RATIO(real) IMP(real) RHOLO(real) RHOHI(real) [PROXY REPLACE]
    local bs = char(92)
    foreach name in r2 b ratio imp rholo rhohi {
        local f_`name' "---"
        if !missing(``name'') {
            local formatted : display %12.4f ``name''
            if abs(``name'') >= 1e7 | (abs(``name'') > 0 & abs(``name'') < .0001) local formatted : display %12.5g ``name''
            local f_`name' = strtrim("`formatted'")
        }
    }
    local h4 "`bs'(`bs'widehat{`bs'rho}_0^{`bs'mathrm{imp}}=1+`bs'gamma`bs')"
    if "`proxy'" != "" {
        local h4 "`bs'(1+`bs'gamma`bs')"
        if "`f_imp'" != "---" local f_imp "`f_imp'`bs'(^{`bs'dagger}`bs')"
    }
    tempname fh
    file open `fh' using `"`using'"', write text `replace'
    file write `fh' "% Generated by preleveldose 0.6; requires booktabs. Supplied-moment calculation." _n
    file write `fh' "`bs'begin{tabular}{rrrr}" _n
    file write `fh' "`bs'toprule" _n
    file write `fh' "`bs'(R^2`bs') & `bs'(b`bs') & `bs'(|R^2/b|/|`bs'beta|`bs') & `h4' `bs'`bs'" _n
    file write `fh' "`bs'midrule" _n
    file write `fh' "`f_r2' & `f_b' & `f_ratio' & `f_imp' `bs'`bs'" _n
    file write `fh' "`bs'bottomrule" _n
    file write `fh' "`bs'end{tabular}" _n
    file write `fh' "`bs'par`bs'smallskip" _n
    file write `fh' "`bs'begin{minipage}{0.95`bs'linewidth}`bs'footnotesize" _n
    file write `fh' "`bs'emph{Notes.} Supplied moments from a common sample, weights and control space." _n
    file write `fh' "The main reading is the channel bound relative to the coefficient, `bs'(|R^2/b|/|`bs'beta|`bs') (on [`f_rholo', `f_rhohi'] the bound is the maximum absolute channel), read as a magnitude without a cut-off and with its Fieller set; a small `bs'(R^2`bs') alone does not end the check, because the bound also scales with `bs'(`bs'mathrm{sd}(S)/`bs'mathrm{sd}(H)`bs')." _n
    if "`proxy'" == "" file write `fh' "When the outcome's own baseline level is added by OLS, `bs'(1+`bs'gamma=`bs'rho_{`bs'mathrm{obs}}+b`bs'beta_1`bs') is an implied counterfactual persistence, read against the persistence restriction and pre-shock benchmarks; it is a point statistic, not a significance test." _n
    else file write `fh' "`bs'(^{`bs'dagger}`bs') The added control is a proxy for the baseline level, not the outcome's own baseline level: `bs'(1+`bs'gamma`bs') is not a persistence." _n
    file write `fh' "The anchor share `bs'(`bs'kappa/`bs'beta`bs') is a secondary quantity and is not reported here. A dash denotes an unavailable statistic, not zero." _n
    file write `fh' "For negative `bs'(b`bs'), raising the cap moves the lower effect endpoint. At zero `bs'(b`bs'), the effect set is all real or empty according to persistence compatibility under unrestricted shape covariance." _n
    file write `fh' "`bs'end{minipage}" _n
    file close `fh'
end
