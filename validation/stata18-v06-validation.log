  4.     if strpos(`"`line'"', "Empty") local emptyset=1
  5.     if strpos(`"`line'"', "[-0.200, 1.200]") local caps=1
  6.     if strpos(`"`line'"', "---") local unavailable=1
  7.     file read `fh' line
  8. }

. file close `fh'

. assert `amp' & `allreal' & `emptyset' & `caps' & `unavailable'

. restore

