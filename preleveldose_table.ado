*! preleveldose_table 0.6 09oct2026
program define preleveldose_table, rclass
    version 15.1
    syntax using/ , SAVing(string) [TITLE(string) LABEL(string) DECimals(integer 4) DIAGNOSTICS REPLACE]
    if `decimals'<0 | `decimals'>8 {
        display as error "decimals() must be between 0 and 8."
        exit 198
    }
    if !regexm(lower(`"`saving'"'), "[.]tex$") {
        display as error "saving() must end in .tex; the input collection is never overwritten."
        exit 198
    }
    if `"`label'"'!="" {
        if !regexm(`"`label'"', "^[A-Za-z0-9:._-]+$") {
            display as error "label() permits letters, digits, colon, period, underscore and hyphen."
            exit 198
        }
        if `"`title'"'=="" {
            display as error "label() requires title() to create a numbered table."
            exit 198
        }
    }
    if "`replace'"=="" confirm new file `"`saving'"'
    preserve
    quietly use `"`using'"', clear
    _preleveldose_check
    local rows = _N
    // Render to a temporary file; invalid input cannot truncate an existing export.
    tempfile rendered
    if "`diagnostics'"=="" mata: _pld_write_table(st_local("rendered"), st_local("title"), st_local("label"), strtoreal(st_local("decimals")))
    if "`diagnostics'"!="" mata: _pld_write_diagnostics(st_local("rendered"), st_local("title"), st_local("label"), strtoreal(st_local("decimals")))
    copy `"`rendered'"' `"`saving'"', `replace'
    restore
    return scalar rows = `rows'
    return local latex_file `"`saving'"'
    return local cmd "preleveldose_table"
    display as text "Exported `rows' specifications to " as result `"`saving'"'
end

mata:
string scalar _pld_escape_tex(string scalar x)
{
    string scalar out, c, bs
    real scalar i
    bs=char(92)
    out=""
    for (i=1; i<=strlen(x); i++) {
        c=substr(x,i,1)
        if (c==bs) out=out+bs+"textbackslash{}"
        else if (strpos("&%$#_{}",c)) out=out+bs+c
        else if (c=="~") out=out+bs+"textasciitilde{}"
        else if (c=="^") out=out+bs+"textasciicircum{}"
        else if (ascii(c)<32) out=out+" "
        else out=out+c
    }
    return(out)
}
string scalar _pld_format(real scalar x, real scalar d)
{
    if (missing(x)) return("---")
    if (abs(x)>=1e7 | (x!=0 & abs(x)<10^(-d))) return(strtrim(strofreal(x,"%12.5g")))
    return(strtrim(strofreal(x,"%21."+strofreal(d)+"f")))
}
string scalar _pld_check_label(string scalar status)
{
    if (status=="passed") return("passed")
    if (status=="legacy_unchecked") return("not checked (legacy row)")
    return("not checked (no controlled dose coefficient)")
}
string scalar _pld_set(string scalar shape, real scalar lo, real scalar hi, real scalar d)
{
    string scalar bs, m
    bs=char(92)
    m=char(36)
    // Stata stores the infinite end of an unbounded Fieller set as missing.
    if (shape=="bounded") return("["+_pld_format(lo,d)+", "+_pld_format(hi,d)+"]")
    if (shape=="two_rays") {
        if (missing(lo)) return(m+"["+_pld_format(hi,d)+","+bs+"infty)"+m)
        if (missing(hi)) return(m+"(-"+bs+"infty,"+_pld_format(lo,d)+"]"+m)
        return(m+"(-"+bs+"infty,"+_pld_format(lo,d)+"]"+bs+"cup["+_pld_format(hi,d)+","+bs+"infty)"+m)
    }
    if (shape=="whole_line") return(m+"(-"+bs+"infty,"+bs+"infty)"+m)
    return("---")
}
string scalar _pld_cell(real scalar i, string scalar key, real scalar d)
{
    string scalar bs, ctype, p
    bs=char(92)
    if (substr(key,1,4)=="set:") {
        p=substr(key,5,.)
        return(_pld_set(st_sdata(i,p+"_shape"), st_data(i,p+"_lo"), st_data(i,p+"_hi"), d))
    }
    if (key=="opg") {
        ctype=st_sdata(i,"control_type")
        if (ctype=="proxy") {
            if (missing(st_data(i,"one_plus_gamma"))) return("---")
            return(_pld_format(st_data(i,"one_plus_gamma"),d)+bs+"textsuperscript{"+bs+"dag}")
        }
        return(_pld_format(st_data(i,"rho_imp"),d))
    }
    if (substr(key,1,4)=="int:") return(_pld_format(st_data(i,substr(key,5,.)),0))
    return(_pld_format(st_data(i,key),d))
}
void _pld_write_table(string scalar path, string scalar title, string scalar label, real scalar d)
{
    real scalar fh, i, j, anyproxy
    real matrix values
    string colvector names, status, checked, origins, ctypes
    string scalar bs, line, interval, caps
    string rowvector keys
    bs=char(92)
    names=st_sdata(.,"row_name")
    status=st_sdata(.,"set_status")
    checked=st_sdata(.,"projection_status")
    origins=st_sdata(.,"origin")
    ctypes=st_sdata(.,"control_type")
    anyproxy=any(ctypes:=="proxy")
    values=st_data(.,tokens("L U rho_lo rho_hi"))
    keys=("R2","b","bound_ratio","set:gb","opg")
    fh=fopen(path,"w")
    fput(fh,"% Generated by preleveldose_table 0.6; requires booktabs and tabularx.")
    if (title!="") {
        fput(fh,bs+"begin{table}[htbp]")
        fput(fh,bs+"centering")
        fput(fh,bs+"caption{"+_pld_escape_tex(title)+"}")
        if (label!="") fput(fh,bs+"label{"+label+"}")
    }
    fput(fh,bs+"begingroup"+bs+"small")
    fput(fh,bs+"setlength{"+bs+"tabcolsep}{3pt}")
    fput(fh,bs+"begin{tabularx}{"+bs+"linewidth}{@{}Xrrrlrll@{}}")
    fput(fh,bs+"toprule")
    fput(fh,"Specification & "+bs+"(R^2"+bs+") & "+bs+"(b"+bs+") & "+bs+"(|R^2/b|/|"+bs+"beta|"+bs+") & Fieller set, "+bs+"(g/"+bs+"beta"+bs+") & "+bs+"(1+"+bs+"gamma"+bs+") & Effect set & Persistence "+bs+bs)
    fput(fh,bs+"midrule")
    for (i=1; i<=rows(names); i++) {
        line=_pld_escape_tex(names[i])
        for (j=1; j<=cols(keys); j++) line=line+" & "+_pld_cell(i,keys[j],d)
        if (status[i]=="all_real") interval="All real"
        else if (status[i]=="empty") interval="Empty"
        else interval="["+_pld_format(values[i,1],d)+", "+_pld_format(values[i,2],d)+"]"
        caps="["+_pld_format(values[i,3],d)+", "+_pld_format(values[i,4],d)+"]"
        fput(fh,line+" & "+interval+" & "+caps+" "+bs+bs)
    }
    fput(fh,bs+"bottomrule")
    fput(fh,bs+"end{tabularx}")
    fput(fh,bs+"par"+bs+"smallskip"+bs+"noindent")
    fput(fh,bs+"begin{minipage}{"+bs+"linewidth}"+bs+"footnotesize")
    fput(fh,bs+"emph{Notes.} Each row uses its own persistence restriction and a common sample, weights and control space. The main reading is the channel bound relative to the coefficient, "+bs+"(|R^2/b|/|"+bs+"beta|"+bs+") (the bound "+bs+"(|R^2/b|"+bs+") times the largest distance of the restriction from one), read as a magnitude without a cut-off and together with the Fieller set of the signed ratio "+bs+"(g/"+bs+"beta"+bs+"), "+bs+"(g=-R^2/b"+bs+"). A bounded set well below one says the channel cannot account for much of the coefficient; a union of rays or the whole line says the data do not bound the ratio. A small "+bs+"(R^2"+bs+") alone does not end the check, because the bound also scales with "+bs+"("+bs+"mathrm{sd}(S)/"+bs+"mathrm{sd}(H)"+bs+").")
    fput(fh,bs+"(1+"+bs+"gamma"+bs+") is the implied counterfactual persistence only when the added control is the outcome's own baseline level, estimated by OLS; it is a point statistic read against the restriction, not a significance test. Effect sets allow unrestricted shape covariance and are not confidence intervals. The anchor share "+bs+"("+bs+"kappa/"+bs+"beta"+bs+") is a secondary quantity stored in the collection (see help preleveldose). Dashes mean unavailable, not zero. For negative "+bs+"(b"+bs+"), raising the cap moves the lower effect endpoint. At zero "+bs+"(b"+bs+"), the effect set is all real or empty according to persistence compatibility; a zero baseline channel does not imply zero total bias.")
    if (anyproxy) fput(fh,bs+"textsuperscript{"+bs+"dag}Proxy control (not the outcome's own baseline level): "+bs+"(1+"+bs+"gamma"+bs+") is not a persistence; the row's "+bs+"(R^2"+bs+") and "+bs+"(b"+bs+") are computed after partialling the proxy.")
    for (i=1; i<=rows(names); i++) {
        line=bs+"par "+_pld_escape_tex(names[i])+": projection identity "+_pld_check_label(checked[i])+"."
        if (origins[i]=="reconstructed_ols") line=line+" Reconstructed baseline OLS; not automatically a published estimate."
        fput(fh,line)
    }
    fput(fh,bs+"end{minipage}")
    fput(fh,bs+"endgroup")
    if (title!="") fput(fh,bs+"end{table}")
    fclose(fh)
}
void _pld_write_diagnostics(string scalar path, string scalar title, string scalar label, real scalar d)
{
    real scalar fh, i, j, p
    real matrix x
    string colvector names, aggregation, inference, sets, clusters, checked, origins, ctypes
    string scalar bs, line, heading, header, aggtext, inftext, settext
    string rowvector keys
    bs=char(92)
    names=st_sdata(.,"row_name")
    checked=st_sdata(.,"projection_status")
    origins=st_sdata(.,"origin")
    sets=st_sdata(.,"set_status")
    clusters=st_sdata(.,"cluster")
    aggregation=st_sdata(.,"aggregation_status")
    inference=st_sdata(.,"inference")
    ctypes=st_sdata(.,"control_type")
    fh=fopen(path,"w")
    fput(fh,"% Generated diagnostic panels (preleveldose 0.6); requires booktabs and tabularx.")
    if (title!="") {
        fput(fh,bs+"begin{table}[htbp]"+bs+"centering")
        fput(fh,bs+"caption{"+_pld_escape_tex(title)+"}")
        if (label!="") fput(fh,bs+"label{"+label+"}")
    }
    fput(fh,bs+"begingroup"+bs+"small")
    for (p=1; p<=6; p++) {
        if (p==1) {
            heading="A. Diagnostic moments"
            keys=("beta","R2","b","rho_obs")
            header="Specification & "+bs+"("+bs+"widehat{"+bs+"beta}"+bs+") & "+bs+"(R^2"+bs+") & "+bs+"(b"+bs+") & "+bs+"("+bs+"rho_{obs}"+bs+")"
        }
        else if (p==2) {
            heading="B. Bound relative to the coefficient (main reading)"
            keys=("channel_bound","bound_ratio","set:gb","set:tau")
            header="Specification & Max. channel & Bound / "+bs+"(|"+bs+"widehat{"+bs+"beta}|"+bs+") & Fieller set, "+bs+"(g/"+bs+"beta"+bs+") & Fieller set, "+bs+"("+bs+"tau("+bs+"rho_{bench})"+bs+")"
        }
        else if (p==3) {
            heading="C. Persistence reading: own baseline level only"
            keys=("opg","gamma","p_equal","p_cap")
            header="Specification & "+bs+"(1+"+bs+"gamma"+bs+") & "+bs+"("+bs+"gamma"+bs+") & Two-sided p & Upper-tail p"
        }
        else if (p==4) {
            heading="D. Null-imposed wild cluster bootstrap"
            keys=("p_equal_wild","p_cap_wild","int:bootstrap_reps","int:bootstrap_seed")
            header="Specification & Two-sided p & Upper-tail p & Replications & Seed"
        }
        else if (p==5) {
            heading="E. Declared aggregation and denominator diagnostics"
            keys=("int:window","working_excess","working_rho","width")
            header="Specification & Window & Working excess & RW benchmark & Set width"
        }
        else {
            heading="F. Instrumented side"
            keys=("g_iv","giv_ratio","set:givb","Q")
            header="Specification & "+bs+"(g_{"+bs+"mathrm{IV}}"+bs+") & "+bs+"(g_{"+bs+"mathrm{IV}}/"+bs+"widehat{"+bs+"beta}_{"+bs+"mathrm{IV}}"+bs+") & Fieller set & "+bs+"(Q"+bs+")"
        }
        fput(fh,bs+"par"+bs+"smallskip"+bs+"noindent"+bs+"textbf{"+heading+"}"+bs+"par")
        if (p==2 | p==6) fput(fh,bs+"begin{tabularx}{"+bs+"linewidth}{@{}Xrrll@{}}"+bs+"toprule")
        else fput(fh,bs+"begin{tabularx}{"+bs+"linewidth}{@{}Xrrrr@{}}"+bs+"toprule")
        fput(fh,header+" "+bs+bs+bs+"midrule")
        for (i=1; i<=rows(names); i++) {
            line=_pld_escape_tex(names[i])
            for (j=1; j<=4; j++) line=line+" & "+_pld_cell(i,keys[j],d)
            fput(fh,line+" "+bs+bs)
        }
        fput(fh,bs+"bottomrule"+bs+"end{tabularx}")
    }
    fput(fh,bs+"par"+bs+"smallskip"+bs+"noindent"+bs+"begin{minipage}{"+bs+"linewidth}"+bs+"footnotesize")
    fput(fh,"Panel B is the main reading: the conditional channel bound relative to "+bs+"(|"+bs+"widehat{"+bs+"beta}|"+bs+"), read as a magnitude without a cut-off, with the Fieller set of the signed ratio "+bs+"(g/"+bs+"beta"+bs+") and of the implied effect at a benchmark persistence. A union of rays or the whole line means the data do not bound the ratio. A small "+bs+"(R^2"+bs+") alone does not end the check. The bound concerns the baseline channel, not total bias. Panel C applies only to the outcome's own baseline level added by OLS; for a proxy control (marked "+bs+"textsuperscript{"+bs+"dag}) "+bs+"(1+"+bs+"gamma"+bs+") is not a persistence and the cap test is not reported. The equality null is "+bs+"("+bs+"gamma=0"+bs+"); the upper-tail null is "+bs+"("+bs+"gamma"+bs+"leq"+bs+"bar{"+bs+"rho}_0-1"+bs+"). Failure to reject does not establish no contamination. Bootstrap columns use null-imposed cluster Rademacher weights and plus-one Monte Carlo p-values. Panel F reports the instrumented lever "+bs+"(g_{"+bs+"mathrm{IV}}="+bs+"mathrm{cov}(Z,S_{pre})/"+bs+"mathrm{cov}(Z,H_{pre})"+bs+") against "+bs+"("+bs+"widehat{"+bs+"beta}_{"+bs+"mathrm{IV}}"+bs+") and "+bs+"(Q=("+bs+"rho_{obs}-1)g_{"+bs+"mathrm{IV}}/"+bs+"widehat{"+bs+"beta}_{"+bs+"mathrm{IV}}"+bs+"). The anchor share "+bs+"("+bs+"kappa/"+bs+"widehat{"+bs+"beta}"+bs+") is a secondary quantity stored in the collection (see help preleveldose).")
    x=st_data(.,tokens("rho_lo rho_hi weak_b bwarn"))
    for (i=1; i<=rows(x); i++) {
        line=bs+"par "+_pld_escape_tex(names[i])+": persistence ["+_pld_format(x[i,1],d)+", "+_pld_format(x[i,2],d)+"]. "
        aggtext="not declared"
        if (aggregation[i]=="random_walk_benchmark") aggtext="random-walk benchmark supplied"
        else if (aggregation[i]=="inputs_missing") aggtext="window declared; variance inputs missing"
        else if (aggregation[i]=="legacy_unknown") aggtext="not recorded in legacy row"
        inftext="not requested"
        if (inference[i]=="cluster_t") inftext="cluster t"
        settext=sets[i]
        if (settext=="all_real") settext="all real"
        line=line+"Effect set: "+settext+". Aggregation: "+aggtext+". Inference: "+inftext+"."
        if (ctypes[i]=="own_baseline") line=line+" Added control: own baseline level."
        else if (ctypes[i]=="proxy") line=line+" Added control: proxy, not a persistence."
        else if (ctypes[i]=="legacy_unknown") line=line+" Control type not recorded in legacy row."
        if (st_sdata(i,"Q_shape")!="not_computed") line=line+" Fieller set for Q: "+_pld_cell(i,"set:Q",d)+"."
        line=line+" Projection identity "+_pld_check_label(checked[i])+"."
        if (origins[i]=="reconstructed_ols") line=line+" Reconstructed baseline OLS; not automatically a published estimate."
        if (clusters[i]!="") line=line+" Cluster: "+_pld_escape_tex(clusters[i])+"."
        if (x[i,3]==1) line=line+" ALERT: "+bs+"(|b|"+bs+"leq "+_pld_format(x[i,4],d)+bs+") (user threshold)."
        fput(fh,line)
    }
    fput(fh,"Working values require a declared averaging window and supplied innovation/window variance under the random-walk benchmark; no cap is changed automatically. Dashes mean unavailable. Zero-b set width is unavailable, not zero; set statuses are reported above.")
    fput(fh,bs+"end{minipage}"+bs+"endgroup")
    if (title!="") fput(fh,bs+"end{table}")
    fclose(fh)
}

end
